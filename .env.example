# Local development placeholders. Never commit your populated .env.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=us-central1
FYNURA_ENV=development
FYNURA_CHAT_MODEL=gemini-3.7-flash
FYNURA_CHAT_LOCATION=global
FYNURA_USE_FIRESTORE=false
FYNURA_ONBOARDING_REQUIRED=false
FYNURA_LIVE_FETCH=true
# Optional only when enabling Firebase sign-in:
# FYNURA_OWNER_EMAIL=YOUR_OWNER_EMAIL
# FYNURA_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
# FYNURA_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FYNURA_SESSION_DAYS=5
